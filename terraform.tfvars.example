################################################################################
# Terraform Variables Example
################################################################################

# =============================================================================
# Required Variables
# =============================================================================

# SSH Key IDs - Get from: scw iam ssh-key list
ssh_key_ids = [
  "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
]

# Proxmox web UI password (root user)
# Must be 8+ chars with uppercase, lowercase, and numbers
service_password = "MySecurePassword123!"

# =============================================================================
# Scaleway Configuration
# =============================================================================

region = "fr-par"
zone   = "fr-par-2"  # Elastic Metal availability zone

# =============================================================================
# Cluster Configuration
# =============================================================================

cluster_name = "proxmox-hci"
node_count   = 3  # Minimum 3 for Ceph

tags = [
  "proxmox",
  "ceph",
  "hci",
  "production",
  "terraform"
]

# =============================================================================
# Server Configuration
# =============================================================================

server_type = "EM-L220E-NVME"

# OS ID for Proxmox VE (latest with: scw baremetal os list zone=fr-par-2 | grep -i proxmox)
# Default: Proxmox VE 8 | Debian 12 (Bookworm)
os_id = "a5c00c1b-95b1-4c08-8a33-79cc079f9dac"

# =============================================================================
# Network Configuration
# =============================================================================

# Public network (Ceph client, MON, iSCSI)
public_network_subnet = "172.16.28.0/22"

# Cluster network (OSD replication)
cluster_network_subnet = "172.16.36.0/22"

# =============================================================================
# Partitioning Configuration
# =============================================================================

enable_custom_partitioning = true

# Partitioning modes:
#   standard      - Full nvme0n1 for OS, nvme1-3 for Ceph OSDs (9 OSDs total)
#   ceph_only     - 50GB root + all 4 NVMe for OSDs (12 OSDs total)
partitioning_mode = "standard"

# =============================================================================
# QDevice Configuration
# =============================================================================

enable_qdevice = true
qdevice_type   = "PLAY2-PICO"  # Minimal instance for quorum
qdevice_ip     = "172.16.28.10"

# =============================================================================
# Output Configuration
# =============================================================================

generate_inventory = true
generate_env_file  = true

# =============================================================================
# Network Auto-Configuration
# =============================================================================

# Automatically configure Private Network VLANs after server installation
# Requires sshpass to be installed locally for initial SSH setup
enable_network_config = true

# Path to SSH private key (must match the public key in ssh_key_ids)
ssh_private_key_path = "~/.ssh/id_rsa"
