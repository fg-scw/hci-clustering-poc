# Network Configuration Example for Proxmox + Ceph HCI
# /etc/network/interfaces
#
# This is a reference configuration for Scaleway Elastic Metal EM-L220E-NVME
# Replace <PUBLIC_VLAN> and <CLUSTER_VLAN> with actual VLAN IDs from Scaleway
#
# Node: pve1 (adjust IPs for pve2 and pve3)

auto lo
iface lo inet loopback

# =============================================================================
# Physical Interface
# =============================================================================
# Main network interface - typically enp67s0f0 on Scaleway Elastic Metal
# This interface carries both VLANs

auto enp67s0f0
iface enp67s0f0 inet manual
    mtu 9000

# =============================================================================
# VLAN for Public Network (Ceph Client Traffic)
# =============================================================================
# Replace <PUBLIC_VLAN> with actual VLAN ID from Scaleway console
# Example: enp67s0f0.2243

auto enp67s0f0.<PUBLIC_VLAN>
iface enp67s0f0.<PUBLIC_VLAN> inet manual
    mtu 9000

# Bridge for Public Network
# - Ceph client (RBD) traffic
# - MON/MGR communication
# - iSCSI exports
# - Dashboard access
# - VM traffic (optional)

auto vmbr1
iface vmbr1 inet static
    address 172.16.28.2/22
    gateway 172.16.28.1
    bridge-ports enp67s0f0.<PUBLIC_VLAN>
    bridge-stp off
    bridge-fd 0
    mtu 9000
#   # For node pve2:
#   # address 172.16.28.3/22
#   # For node pve3:
#   # address 172.16.28.4/22

# =============================================================================
# VLAN for Cluster Network (OSD Replication)
# =============================================================================
# Replace <CLUSTER_VLAN> with actual VLAN ID from Scaleway console
# Example: enp67s0f0.2462

auto enp67s0f0.<CLUSTER_VLAN>
iface enp67s0f0.<CLUSTER_VLAN> inet manual
    mtu 9000

# Bridge for Cluster Network
# - OSD ↔ OSD replication
# - Recovery/backfill traffic
# - Rebalancing
# No gateway needed - isolated network

auto vmbr2
iface vmbr2 inet static
    address 172.16.36.2/22
    bridge-ports enp67s0f0.<CLUSTER_VLAN>
    bridge-stp off
    bridge-fd 0
    mtu 9000
#   # For node pve2:
#   # address 172.16.36.3/22
#   # For node pve3:
#   # address 172.16.36.4/22

# =============================================================================
# Optional: Additional Management Bridge (Scaleway Public IP)
# =============================================================================
# If you want to use Scaleway's public IP for management
# This is typically handled by Scaleway's existing configuration
# Uncomment and adjust if needed

# auto vmbr0
# iface vmbr0 inet dhcp
#     bridge-ports enp67s0f1
#     bridge-stp off
#     bridge-fd 0

# =============================================================================
# Notes
# =============================================================================
#
# VLAN Discovery:
#   After attaching Elastic Metal to Private Network in Scaleway console:
#   1. Check Scaleway console for assigned VLAN ID
#   2. Or detect from system: cat /proc/net/vlan/config
#
# MTU 9000 (Jumbo Frames):
#   - Improves throughput for large transfers
#   - Must be consistent across all nodes
#   - Scaleway Private Networks support jumbo frames
#
# Applying Changes:
#   systemctl restart networking
#   # Or reboot for clean state
#
# Verification:
#   ip addr show vmbr1
#   ip addr show vmbr2
#   ping -c 3 172.16.28.3  # Other node on public network
#   ping -c 3 172.16.36.3  # Other node on cluster network
#   iperf3 -c 172.16.36.3  # Test bandwidth
#
# IP Allocation:
#   Node    Public (vmbr1)    Cluster (vmbr2)
#   pve1    172.16.28.2       172.16.36.2
#   pve2    172.16.28.3       172.16.36.3
#   pve3    172.16.28.4       172.16.36.4
#   qdev    172.16.28.10      (not needed)
