################################################################################
# Terraform Variables Example
# Copy to terraform.tfvars and customize
################################################################################

# =============================================================================
# Required Variables
# =============================================================================

# SSH Key IDs from Scaleway IAM
# Get with: scw iam ssh-key list
# 
# IMPORTANT: Cloud-init is NOT supported on Proxmox VE images for Elastic Metal.
# After deployment, you must manually configure SSH on each node.
# See README.md for the manual SSH configuration steps.
ssh_key_ids = [
  "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
]

# Proxmox web UI password (root user)
# Must be 8+ chars with uppercase, lowercase, and numbers
service_password = "YourSecurePassword123!"

# =============================================================================
# Scaleway Configuration
# =============================================================================

region = "fr-par"
zone   = "fr-par-2"  # Elastic Metal availability zone

# Optional: Specify project ID (uses default if not set)
# project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# =============================================================================
# Cluster Configuration
# =============================================================================

cluster_name = "proxmox-hci"
node_count   = 3  # Minimum 3 for Ceph

tags = [
  "proxmox",
  "ceph",
  "hci",
  "terraform"
]

# =============================================================================
# Server Configuration
# =============================================================================

# Available types with disk configurations:
#   EM-L220E-NVME  - Lithium: 8C AMD EPYC, 64GB RAM, 4x1.92TB NVMe → 3 OSDs/node
#   EM-I120E-NVME  - Iridium: 8C/16T, 64GB RAM, 2x960GB NVMe     → 1 OSD/node
#   EM-A315X-SSD   - Aluminium: 8C, 64GB, 2x1TB SSD               → 1 OSD/node
#   EM-A410X-SSD   - Aluminium: 16C, 128GB, 2x1TB SSD             → 1 OSD/node
server_type = "EM-L220E-NVME"

# Optional: Override OSD disks (auto-detected based on server_type if empty)
# ceph_osd_disks = ["/dev/nvme1n1", "/dev/nvme2n1", "/dev/nvme3n1"]

# OS ID for Proxmox VE (get latest with: scw baremetal os list zone=fr-par-2 | grep -i proxmox)
# Default: Proxmox VE 8 | Debian 12 (Bookworm)
os_id = "a5c00c1b-95b1-4c08-8a33-79cc079f9dac"

# =============================================================================
# Network Configuration
# =============================================================================

# Public network (Ceph client, MON, iSCSI)
public_network_subnet = "172.16.28.0/22"

# Cluster network (OSD replication)
cluster_network_subnet = "172.16.36.0/22"

# Optional: Specify static IPs (auto-generated if empty)
# public_network_ips  = ["172.16.28.2", "172.16.28.3", "172.16.28.4"]
# cluster_network_ips = ["172.16.36.2", "172.16.36.3", "172.16.36.4"]

# =============================================================================
# Partitioning Configuration
# =============================================================================

# Enable custom partitioning: OS on nvme0n1, other disks free for Ceph OSDs
enable_custom_partitioning = true

# =============================================================================
# QDevice Configuration
# =============================================================================

enable_qdevice = true
qdevice_type   = "DEV1-S"  # Minimal instance for quorum
qdevice_ip     = "172.16.28.10"

# =============================================================================
# Output Configuration
# =============================================================================

generate_inventory = true
generate_env_file  = true

# =============================================================================
# SSH Configuration (for Ansible)
# =============================================================================

# Path to SSH private key for Ansible connections
ssh_private_key_path = "~/.ssh/id_rsa"

# =============================================================================
# Public Gateway Configuration
# =============================================================================

# Enable Public Gateway for VM internet access
enable_public_gateway = true

# Gateway type: VPC-GW-S (up to 50 SMGW units) or VPC-GW-M (up to 500)
public_gateway_type = "VPC-GW-S"

# Enable SSH bastion on the gateway
enable_ssh_bastion = true

# SSH bastion port
bastion_port = 61000
